# ============================================
#  Movie Server - configuration
#  Copy to `.env` and fill in what you need.
#  Every storage provider is OPTIONAL — enable only the ones you use.
# ============================================

# ---------- Core ----------
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Public base URL of the site (used for links, TMDB images, redirects)
PUBLIC_URL=http://localhost:3000

# Secret used to sign login tokens. CHANGE THIS!
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Brute-force protection for the login endpoint
LOGIN_RATE_MAX=10
LOGIN_RATE_WINDOW_MS=900000
REGISTER_RATE_MAX=20

# Trust proxy (set to 1 when behind Nginx/Cloudflare so real IPs + https work)
TRUST_PROXY=1

# ---------- Database ----------
# SQLite file location
DB_PATH=./data/movie-server.db

# ---------- Local library ----------
# Root folder that holds your movie files (scanned into the library)
LIBRARY_ROOT=./data/library
# Where posters/backdrops/subtitles are cached
DATA_ROOT=./data

# ---------- Cloudflare R2 ----------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: pre-created bucket name
R2_BUCKET=movies
# Optional: custom endpoint, leave empty to auto-build from account id
R2_ENDPOINT=

# ---------- Google Drive ----------
# Use a service account (recommended) or an OAuth refresh token.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=
# Or OAuth client + refresh token (alternative to service account)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ---------- MEGA ----------
# mega.js is free with a 20GB storage quota per account.
MEGA_EMAIL=
MEGA_PASSWORD=
# Optional: the root folder name to expose
MEGA_ROOT_FOLDER=

# ---------- Telegram ----------
# The bot uploads files to Telegram, the site streams them back out.
# NOTE: Bot API file uploads are capped at 50MB, downloads at 20MB.
# Use this provider for small/short files, or as a backup tier.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- TMDB (optional, for poster/metadata lookup) ----------
TMDB_API_KEY=
TMDB_LANGUAGE=en-US

# ---------- Uploads ----------
MAX_UPLOAD_SIZE=5368709120

# ---------- Streaming ----------
# Number of seconds a signed stream URL stays valid
STREAM_URL_TTL=7200

# ---------- Background jobs (ffmpeg) ----------
# Shared secret that lets the ffmpeg worker read source files through the
# normal streaming route. Leave it empty to have one generated at startup
# (it then changes on every restart). Set it to a long random string to keep
# it stable — a placeholder value is ignored and replaced automatically.
JOB_TOKEN=

# ---------- Debugging ----------
# When true, error responses include the underlying detail. NEVER enable this
# on a public deployment.
DEBUG=false
