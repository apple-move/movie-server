{
  "name": "movie-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted movie server with pluggable storage (Local / Cloudflare R2 / Google Drive / MEGA / Telegram), online streaming and downloads.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "admin:create": "node server/cli/create-admin.js",
    "scan": "node server/cli/scan.js",
    "test": "node scripts/check-imports.js && node scripts/test-api.js",
    "test:api": "node scripts/test-api.js",
    "test:archive": "node scripts/test-archive-hls.js",
    "test:security": "node scripts/test-security.js",
    "test:tmdb": "node scripts/test-tmdb.js",
    "test:ui": "node scripts/test-ui.js",
    "test:playback": "node scripts/test-playback.js",
    "test:remux": "node scripts/test-remux.js",
    "test:reset": "node scripts/reset-library.js",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "lint:encoding": "node scripts/check-encoding.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@aws-sdk/s3-request-presigner": "^3.1153.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.1",
    "googleapis": "^186.0.0",
    "hls.js": "^1.7.3",
    "jsonwebtoken": "^9.0.3",
    "megajs": "^1.3.10",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
